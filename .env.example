# 复制为 .env 后修改。.env 已被 git 忽略, 不要提交真实密钥。

# 对外端口
SNOW_PORT=8080
# Radmin VPN 独立入口：填本机 Radmin VPN 的 IPv4 地址
RADMIN_BIND_IP=127.0.0.1
RADMIN_PORT=18080

# 数据库密码(首次启动时生效; 修改后需删除 pgdata 卷重建)
DB_PASSWORD=snow_dev
# 可切换至独立演示快照库，默认使用完整历史库。
SNOW_DB_NAME=snow_world

# 演示数据与回放时钟(冰雪季春节场景); 留空 DEMO_REPLAY_AT 则使用真实当前时间
DEMO_SEED=true
DEMO_HISTORY_FROM=2025-11-01
DEMO_REPLAY_AT=2026-02-18T14:30:00+08:00
# 全部演示账号的统一密码(至少 10 位)
DEMO_PASSWORD=Snow@2026demo

# AI: fake = 本地规则模拟(无需联网); deepseek = 任意 OpenAI 兼容接口
AI_PROVIDER=fake
# 官方: https://api.deepseek.com ; 宿主机上的网关示例: http://host.docker.internal:3000/v1
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash

# 国内构建可改用镜像源, 例如 https://registry.npmmirror.com/
NPM_REGISTRY=https://registry.npmjs.org/
# 拉取 PostGIS 镜像缓慢时可替换为镜像仓库地址
POSTGIS_IMAGE=postgis/postgis:17-3.5
